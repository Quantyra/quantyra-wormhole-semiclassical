{"started_utc": "2026-10-25T13:32:59.664038+00:00", "mode": "development", "input_sha256_before": {"checks/current_all_angular_principal_operator.py": "18bc17175855ee53c80e13eb5afb0a3fd2172ca92246b2ae17614e5479f8f0ec", "checks/current_coincident_dirac_action_assembly.py": "40903136c7384d001f5d8a05f308457a45ac3bfb4e575e7796315fa5bab553fb", "checks/current_coupled_input_energy_bound.py": "f7ff66ada049f5ce07099d031d8a6924338b601b8c5f02c2f9fc1fc279c6eb4b", "checks/current_endpoint_thermal_restoration.py": "5071d56c93bb42e0d54cef36013165029952ebb411f74f19805aadc600fd99cd", "checks/current_physical_york_dual_assembly.py": "ad0b63037bcadcc4ecfdaa48148e5ce1f07494cbc8eca55fc0297464fbb51e4d", "checks/current_seed_radial_green_enclosure.py": "96714512659526c91418cf196aa3a7620d593db0f9333246a2a0f4f4b4fa76e4", "checks/current_seed_separated_quantum_response.py": "68c12a235ddb425f3427aab60936c2d89317adc73f575bde259b2ccb28179243", "checks/current_subtracted_thermal_action.py": "d14c90bdc2ac7c475c44a3f22ea4fd13327933c6036cfb6d626028daad052da2", "evidence/current-coupled-input-energy-bound-review.json": "2a9da53e571266dba4897c72854a34ad9ae1d8d9669cd2f4c0cbd4088c3db3f1", "notes/current-controlled-solution-audit-closeout.md": "3dfe40a660a7782947375e75714c3f126fea66923dafeee040f2279d250d921e", "notes/current-coupled-global-return-attempt.md": "ea8991b327368c5adb0b3c2104731f0aef887e0f16f1e0733fb8b835e3f72b2c", "notes/current-coupled-input-energy-bound.md": "481a48caeaff64e441d4e6e0a4b4717fbdecc49fed8f37ae225b90b90d4f7d58", "notes/current-coupled-return-tail-attempt.md": "d899f81cf5c121009f8946aaaab0506d2d03a85dcc9006267d9edcdfc821811f", "notes/current-finite-local-action-assembly.md": "73c07a2153ad8f5309c1744f1eab88b5a88029cc02ef4c18e3191aff491ce645", "notes/current-geodesic-two-sided-remainder.md": "f2451000efd4d67bb89849379fa027bc62eea3d102387eaa60ae1b63994a58de", "notes/current-global-return-energy-attempt.md": "c08c47ca234c0db12e48d4561213113b24c8fc59684be89e71a4e3f72338204b", "notes/current-localized-bolt-adjoint-sensitivity.md": "d418f94f18129432c23509793cdfbb158748083d971d2e479ef8d7f83190f1de", "notes/current-physical-york-dual-assembly.md": "73ba04204e1899a4eb2d433b9b75654caa98acbe667917e82733e875ed6f05a6", "notes/current-short-travel-strong-domain.md": "3f292f320acd20cba17292a1d8aa087c5e6dd4c956ecff672f4da4fed840f9ea"}, "precision_bits": 512, "runtime": {"python": "3.13.7 (tags/v3.13.7:bcee1c3, Aug 14 2025, 14:15:11) [MSC v.1944 64 bit (AMD64)]", "python_executable_sha256": "d932e5e2f324d57f392e8fd063dcf6d0185be8a664c57c6d24e7762ed02c28ca", "flint_version": "0.9.0", "flint_artifacts": {"__init__.py": "51b38d54b85e213a7ae1e801f9d6e9fec6e31aa25d28f57732df12dc0f1d0948", "flint_base/__init__.py": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "flint_base/flint_base.cp313-win_amd64.pyd": "a02e2ca0719a4832abbbf3685fc667a63030d4744a2ef0c208a5a1fab421a6da", "flint_base/flint_context.cp313-win_amd64.pyd": "4d44bc6e64c47d47660c6e2f2bf38a3a643405def2b53db5539e25f32f9b7258", "functions/__init__.py": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "functions/showgood.cp313-win_amd64.pyd": "af53f6cc9a99f381516f86a82a4161a89115052406104ad7aed0623866aa96d0", "pyflint.cp313-win_amd64.pyd": "8c9f45243632706337d5218d5e515ddeeac4836e224aec89b3abef72b0407321", "test/__init__.py": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "test/__main__.py": "bc5a3d8b710eb54d311ae642f48122791a17cef8e22d409bee9fab8bb7907b63", "test/helpers.py": "1c51182ad26c6c5215a4570d0371ae218b144c4e500784b03d3fd56b1c050c89", "test/test_acb.py": "44e6eb84f02624b5abf270a72349d97549d286337ccf0f2a8e10f36124418afe", "test/test_acb_mat.py": "e99c9f84a03c9dd44c8bf710d70c1958fa3791cb101c49df106e24969ad13c44", "test/test_acb_poly.py": "8e36bbd3e5d18409c4316b029f80f6578af6ce944ac3167f28e93c647b8a01a2", "test/test_acb_series.py": "064064ba49576786703ee945b114e2383c0501b792fd3dfc3c45ab221be8c9f2", "test/test_acb_theta.py": "02a22f96fe78c