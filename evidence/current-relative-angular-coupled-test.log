{"started_utc": "2026-10-25T16:43:56.156808+00:00", "mode": "development", "input_sha256_before": {"checks/current_all_angular_principal_operator.py": "18bc17175855ee53c80e13eb5afb0a3fd2172ca92246b2ae17614e5479f8f0ec", "checks/current_coincident_dirac_action_assembly.py": "40903136c7384d001f5d8a05f308457a45ac3bfb4e575e7796315fa5bab553fb", "checks/current_endpoint_thermal_restoration.py": "5071d56c93bb42e0d54cef36013165029952ebb411f74f19805aadc600fd99cd", "checks/current_physical_york_dual_assembly.py": "ad0b63037bcadcc4ecfdaa48148e5ce1f07494cbc8eca55fc0297464fbb51e4d", "checks/current_relative_angular_coupled_test.py": "ef60c1198cdfdabdb754972ed2de9f2357c72ef1a72a31fb542f5e94aa0d0692", "checks/current_seed_radial_green_enclosure.py": "96714512659526c91418cf196aa3a7620d593db0f9333246a2a0f4f4b4fa76e4", "checks/current_seed_separated_quantum_response.py": "68c12a235ddb425f3427aab60936c2d89317adc73f575bde259b2ccb28179243", "checks/current_subtracted_thermal_action.py": "d14c90bdc2ac7c475c44a3f22ea4fd13327933c6036cfb6d626028daad052da2", "evidence/current-paired-response-parametrix-bound.json": "350dc6b5126a22115ce8e1a4816c272e54bee33a039acb790c82c7e5f6b2dd2e", "evidence/current-relative-angular-coupled-test-review.json": "54615d2bc9772c008fa5882149bbf78f3d18a0920ddad342b9e827942f09c62c", "notes/current-controlled-solution-audit-closeout.md": "3dfe40a660a7782947375e75714c3f126fea66923dafeee040f2279d250d921e", "notes/current-coupled-global-return-attempt.md": "ea8991b327368c5adb0b3c2104731f0aef887e0f16f1e0733fb8b835e3f72b2c", "notes/current-geodesic-two-sided-remainder.md": "f2451000efd4d67bb89849379fa027bc62eea3d102387eaa60ae1b63994a58de", "notes/current-global-far-return-energy-bound.md": "a0d54bf4ab914ebd121c106c160792d3fb4961caf0fbb031e2f742b8572c0a82", "notes/current-mass-response-regulator-audit.md": "83aff13073f2e50700e020231545d00883a9831a8a85812567d4c484a9033a71", "notes/current-paired-quantum-scalar-return.md": "6db8f5dc458fcce02dbfc44f335546a0907da0dc07df0198d47