      "s169eb-normal-jets-explore.py": {
        "sha256": "e12d72584641d6c0a362a4ef0983ab3533077bfff9b9181fbe6662850189402e",
        "contents": "from pathlib import Path\nimport sympy as s\nimport json,time\nz=s.symbols('z',positive=True)\nq=s.symbols('q0:9');bs=s.symbols('b0:9');I=s.symbols('I');a=s.symbols('a',positive=True)\ndef D(x):return s.expand(sum(s.diff(x,q[j])*q[j+1]+s.diff(x,bs[j])*bs[j+1] for j in range(8))+s.diff(x,z))\ninv=[1/q[0]]\nfor k in range(4):inv.append(s.cancel(D(inv[-1])))\ntb=sum(inv[k-1]*a**k/(2**k*s.factorial(k))*z**k for k in range(1,6))\n# z here is a formal auxiliary variable only for coefficient extraction.\nco={}\nfor n in range(6):\n p=s.Poly(s.expand(tb**n/s.factorial(n)),z)\n for k in range(n,6):co[n,k]=p.coeff_monomial(z**k)\nflow=[bs[0]]\nfor n in range(5):flow.append(s.expand(q[0]*D(flow[-1])))\nclk={bs[0]:1+q[1]*I/2}\nfor j in range(1,6):\n clk[bs[j]]=q[j+1]*I/2+sum(s.binomial(j,r)*q[r+1]*inv[j-r-1]/2 for r in range(j))\ncx,cy=s.symbols('cx cy',real=True)\nout={}\nfor order in range(6):\n mixed=0\n for j in range(order+1):\n  k=order-j\n  v=0\n  for n in range(k+1):\n   d=flow[n]\n   for vj in range(j):d=D(d)\n   v+=co.get((n,k),0)*d*a**j/(2**j*s.factorial(j))\n  mixed+=v*(cx+s.I*cy)**j*(cx-s.I*cy)**k\n mixed=s.Poly(s.expand(mixed),cx,cy)\n for jy in range(0,order+1,2):\n  jx=order-jy\n  val=mixed.coeff_monomial(cx**jx*cy**jy)*s.factorial(jx)*s.factorial(jy)\n  val=s.cancel(val.subs(clk).subs(q[0],a*a))\n  out[str((jx,jy))]=str(val)\n print(order,'done',flush=True)\nPath(__file__).with_suffix('.json').write_text(json.dumps(out,indent=2))\nprint(out)\n"
      },
