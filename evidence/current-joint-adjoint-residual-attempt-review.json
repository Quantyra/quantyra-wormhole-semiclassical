        "contents": "from pathlib import Path\nimport json,sys\nsys.path.insert(0,'C:/Users/dfred/AppData/Local/Temp/s169af-arb')\nimport mpmath as m\nimport sympy as s\nm.mp.dps=100\nroot=Path('C:/Users/dfred/Desktop/Projects/IGH/quantyra-wormhole-semiclassical')\ndef prior(n):return json.loads((root/'evidence'/(n+'.json')).read_bytes())['runs'][-1]['result']\ndef dec(v):\n d=v['decimal_enclosure'];return m.mpf(d['mid'])*m.mpf(10)**int(d['exponent'])\np=prior('current-global-mass-conversion')['parameters']\nbe,u,ep,tau=[dec(p[k]) for k in ['beta','u','eps','tau']]\nz=s.symbols('z');bb,uu,ee,tt=s.symbols('bb uu ee tt')\nqexpr=(1-z)**2*(bb*(1+2*z+3*z*z)+uu*z*z+ee*z**4)-tt*z**3\nqf=[s.lambdify((z,bb,uu,ee,tt),s.diff(qexpr,z,j),'mpmath') for j in range(7)]\ndef qs(z):return [f(z,be,u,ep,tau) for f in qf]\njets=json.loads(Path(__file__).with_name('s169eb-normal-jets-explore.json').read_bytes())\nI,a=s.symbols('I a');q=s.symbols('q0:9')\nfs={key:s.lambdify((I,a,*q[1:7]),s.sympify(value,locals={'I':I}),'mpmath') for key,value in jets.items()}\nout=[]\nfor zs in ['0','.05','.1','.2','.3','.4','.5','.6','.7','.8','.9','.99','.9999','0.99999999']:\n zz=m.mpf(zs);qq=qs(zz);inte=m.quad(lambda t:1/qs(t)[0],[0,zz/2,zz])\n vals={key:f(inte,m.sqrt(qq[0]),*qq[1:7]) for key,f in fs.items()}\n mx=max(abs(v) for v in vals.values())\n out.append({'z':zs,'clock_centre_jet_max':str(mx),'jets':{k:str(v) for k,v in vals.items()}})\n print(zs,m.nstr(mx,10),max(vals,key=lambda k:abs(vals[k])),flush=True)\nPath(__file__).with_suffix('.json').write_text(json.dumps({'WARNING':'Non-certified midpoint exploration. Clock-only, no whole-chart, mass, cold-bolt or common-operator conclusion.','values':out},indent=2))\n"
      },
