        "contents": "{\n  \"(0, 0)\": \"I*q1/2 + 1\",\n  \"(1, 0)\": \"(I*a**2*q2 + q1)/(2*a)\",\n  \"(2, 0)\": \"(2*I*a**4*q3 + I*a**2*q1*q2 + 4*a**2*q2 - q1**2)/(4*a**2)\",\n  \"(0, 2)\": \"(I*a**2*q1*q2 + q1**2)/(4*a**2)\",\n  \"(3, 0)\": \"(4*I*a**6*q4 + 6*I*a**4*q1*q3 + 3*I*a**4*q2**2 + 12*a**4*q3 - a**2*q1*q2 + 2*q1**3)/(8*a**3)\",\n  \"(1, 2)\": \"(2*I*a**4*q1*q3 + I*a**4*q2**2 + 5*a**2*q1*q2 - 2*q1**3)/(8*a**3)\",\n  \"(4, 0)\": \"(8*I*a**8*q5 + 24*I*a**6*q1*q4 + 31*I*a**6*q2*q3 + 6*I*a**4*q1**2*q3 + 6*I*a**4*q1*q2**2 + 32*a**6*q4 + 23*a**4*q1*q3 + 16*a**4*q2**2 + 10*a**2*q1**2*q2 - 6*q1**4)/(16*a**4)\",\n  \"(2, 2)\": \"(4*I*a**6*q1*q4 + 5*I*a**6*q2*q3 + 2*I*a**4*q1**2*q3 + 2*I*a**4*q1*q2**2 + 13*a**4*q1*q3 + 8*a**4*q2**2 - 14*a**2*q1**2*q2 + 6*q1**4)/(16*a**4)\",\n  \"(0, 4)\": \"(-I*a**6*q2*q3 + 6*I*a**4*q1**2*q3 + 6*I*a**4*q1*q2**2 - a**4*q1*q3 + 18*a**2*q1**2*q2 - 6*q1**4)/(16*a**4)\",\n  \"(5, 0)\": \"(16*I*a**10*q6 + 80*I*a**8*q1*q5 + 135*I*a**8*q2*q4 + 70*I*a**8*q3**2 + 60*I*a**6*q1**2*q4 + 150*I*a**6*q1*q2*q3 + 30*I*a**6*q2**3 + 80*a**8*q5 + 159*a**6*q1*q4 + 260*a**6*q2*q3 + 28*a**4*q1**2*q3 + 46*a**4*q1*q2**2 - 56*a**2*q1**3*q2 + 24*q1**5)/(32*a**5)\",\n  \"(3, 2)\": \"(8*I*a**8*q1*q5 + 13*I*a**8*q2*q4 + 6*I*a**8*q3**2 + 12*I*a**6*q1**2*q4 + 30*I*a**6*q1*q2*q3 + 6*I*a**6*q2**3 + 33*a**6*q1*q4 + 48*a**6*q2*q3 - 20*a**4*q1**2*q3 - 26*a**4*q1*q2**2 + 64*a**2*q1**3*q2 - 24*q1**5)/(32*a**5)\",\n  \"(1, 4)\": \"(-I*a**8*q2*q4 - 2*I*a**8*q3**2 + 12*I*a**6*q1**2*q4 + 30*I*a**6*q1*q2*q3 + 6*I*a**6*q2**3 - a**6*q1*q4 - 4*a**6*q2*q3 + 44*a**4*q1**2*q3 + 54*a**4*q1*q2**2 - 72*a**2*q1**3*q2 + 24*q1**5)/(32*a**5)\"\n}"
