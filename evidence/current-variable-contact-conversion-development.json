    "s169ce-graph-dev.py": {
      "sha256": "8fbd26518bfd34a76e687961d6bcf17b7c85c48bd821849ab9f514c63a1b7b28",
      "utf8": "from pathlib import Path\nimport sys,json\nsys.path[:0]=['C:/Users/dfred/AppData/Local/Temp/s169af-arb','C:/Users/dfred/Desktop/Projects/IGH/quantyra-wormhole-semiclassical/checks']\nimport sympy as S\nfrom flint import arb,ctx\nimport current_product_matched_source_projection as old\nctx.prec=512\nz,s=S.symbols('z s');be,u,ep,ta,q,C=S.symbols('beta u eps tau q C')\nQ=be+u*z**2+(-4*be-2*u-ta)*z**3+(3*be+u+ep)*z**4-2*ep*z**5+ep*z**6\nder=lambda v:S.diff(v,z)+s*v/z\nlap=lambda v:der(Q*der(v))\nR=-S.diff(Q,z,2);DR=S.diff(Q*S.diff(R,z),z);H0=-q-S.Rational(1,3);H1=(q*q/6-S.Rational(1,30))/C\nH=lap(lap(S.Integer(1)))/30-(R*lap(S.Integer(1))+Q*S.diff(R,z)*s/z)/10-H0*lap(S.Integer(1))/(6*C)-(4*H1/C+R**2/30+DR/15)\nA=S.expand(z**4*H);T=S.expand(z*S.diff(A,z)+(s-4)*A)\nnormal=S.Poly(T,z).nth(0);assert S.simplify(normal-be**2*(s-4)*s*(s-1)*(s-2)*(s-3)/30)==0\npars,hh,zh,env=old.scalar.prev.york.actual_parameters();mapping={be:pars['beta'],u:pars['u'],ep:pars['eps'],ta:pars['tau'],q:arb(pars['q']),C:pars['C']}\ndef val(e):\n if e in mapping:return mapping[e]\n if e.is_Rational:return arb(int(e.p))/int(e.q)\n if e.is_Add:return sum((val(v) for v in e.args),arb(0))\n if e.is_Mul:\n  out=arb(1)\n  for v in e.args:out*=val(v)\n  return out\n if e.is_Pow:return val(e.base)**int(e.exp)\n raise ValueError(e)\nroot=Path('C:/Users/dfred/Desktop/Projects/IGH/quantyra-wormhole-semiclassical')\nprior=json.loads((root/'evidence/current-local-quantum-contact-graph.json').read_bytes())['runs'][-1]['result']\ncaps=[old.decode(v) for v in prior['shape_multiplier_constants']]\nitems=[];eta=arb(0);t=S.symbols('t');fac=pars['C']/(arb.pi()*pars['B2'])\nfor (p,),coeff in S.Poly(T-normal,z).terms():\n poly=S.Poly(S.expand(coeff.subs(s,t+S.Rational(801,200))),t)\n bound=sum((val(poly.nth(k)).abs_upper()*caps[k] for k in range(poly.degree()+1)),arb(0))\n term=fac*arb('.01')**p*(p**3+12*p*p+51*p+100)*bound\n eta+=term;items.append({'power':p,'symbol':str(coeff),'bound':old.encoded(term)})\nans={'eta':old.encoded(eta),'threshold':old.encoded(arb('.18')-eta),'normal':str(S.factor(normal)),'terms':items}\nPath(__file__).with_suffix('.json').write_bytes((json.dumps(ans,indent=2)+'\\n').encode())\nprint(json.dumps({k:v for k,v in ans.items() if k!='terms'},indent=2))\n"
