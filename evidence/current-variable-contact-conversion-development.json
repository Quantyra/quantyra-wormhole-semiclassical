    "s169ce-wick-dev.py": {
      "sha256": "6b9e9916fdd66acdcec03cc6cb1ef2e982dd7d01c24b6329bf37ec1ec06cded1",
      "utf8": "from pathlib import Path\nimport sys,json\nsys.path[:0]=['C:/Users/dfred/AppData/Local/Temp/s169af-arb','C:/Users/dfred/Desktop/Projects/IGH/quantyra-wormhole-semiclassical/checks']\nimport sympy as S\nimport current_curved_paired_heat_bridge as prior\nh=S.symbols('h');f=S.symbols('f0:7',positive=True);v=S.symbols('v0:7');u=S.symbols('u0:7');mu=S.symbols('m1:5')\nfield=sum(f[j]*h**j/S.factorial(j) for j in range(5))\nA=sum(S.expand(field**2).coeff(h,j)*(1 if j==0 else mu[j-1])*h**j for j in range(5))\nB=sum(f[j+1]*(1 if j==0 else mu[j-1])*h**j/S.factorial(j) for j in range(4))\nw=(A-f[0]**2)/f[0]**2\npower=lambda p:S.series(sum(S.binomial(p,k)*w**k for k in range(5)),h,0,5).removeO()*f[0]**(2*p)\nH=S.series(power(-S.Rational(1,2))+h*h*B**2*power(-S.Rational(3,2))/4+h**4*B**4*power(-S.Rational(5,2))/32,h,0,5).removeO().expand()\nV=sum(v[j]*(1 if j==0 else mu[j-1])*h**j/S.factorial(j) for j in range(5))\nmom={};out=[]\nfor j in [0,2,4]:\n ans=0\n for ps,c in S.Poly(S.expand(H*V).coeff(h,j),*mu).terms():\n  part=tuple(sorted((a+1 for a,b in enumerate(ps) for _ in range(b)),reverse=True))\n  if not part:ans+=c\n  else:\n   if part not in mom:mom[part]=prior.bridge_moment(part)\n   ans+=c*mom[part]\n out.append(S.factor(ans))\nD=lambda e:S.expand(sum(S.diff(e,f[j])*f[j+1]+S.diff(e,v[j])*v[j+1]+S.diff(e,u[j])*u[j+1] for j in range(6)))\nR=2*f[2]/f[0]-4*f[1]**2/f[0]**2\nlap=lambda e:D(D(e))-f[1]/f[0]*D(e)\na2=-R**2/120-lap(R)/60\ntarget=[2*v[0]/f[0],(-R*v[0]/6+lap(v[0])/3)/f[0],(a2*v[0]-(R*lap(v[0])+D(R)*v[1])/60+lap(lap(v[0]))/30)/f[0]]\nres=[S.factor(2*out[j]-target[j]) for j in range(3)]\ndata={'coefficients':[str(x) for x in out],'residuals':[str(x) for x in res],'moments':{str(k):str(vv) for k,vv in mom.items()}}\nPath(__file__).with_suffix('.json').write_text(json.dumps(data,indent=2)+'\\n')\nprint(json.dumps(data,indent=2))\n"
    },
