      "sha256": "3c4e02bc1dd496709e382b3cdb4348aa492923eaa733897863b016ec435fc6b0",
      "utf8": "{\n  \"coefficients\": [\n    \"v0/f0\",\n    \"-(-f0**2*v2 + f0*f1*v1 + f0*f2*v0 - 2*f1**2*v0)/(6*f0**3)\",\n    \"-(-f0**4*v4 + 2*f0**3*f1*v3 + 3*f0**3*f2*v2 + 2*f0**3*f3*v1 + f0**3*f4*v0 - 5*f0**2*f1**2*v2 - 10*f0**2*f1*f2*v1 - 7*f0**2*f1*f3*v0 - 4*f0**2*f2**2*v0 + 9*f0*f1**3*v1 + 23*f0*f1**2*f2*v0 - 12*f1**4*v0)/(60*f0**5)\"\n  ],\n  \"residuals\": [\n    \"0\",\n    \"0\",\n    \"0\"\n  ],\n  \"moments\": {\n    \"(1, 1)\": \"1/6\",\n    \"(2,)\": \"1/3\",\n    \"(1, 1, 1, 1)\": \"1/12\",\n    \"(2, 1, 1)\": \"11/90\",\n    \"(3, 1)\": \"1/5\",\n    \"(2, 2)\": \"1/5\",\n    \"(4,)\": \"2/5\"\n  }\n}\n"
