{
  "scope": "Exploratory cubic local conversion graph arithmetic; not a nonlocal quantum certificate",
  "source_utf8": "from pathlib import Path\nfrom math import comb\nimport json,sys\np=Path(__file__).parent;prev=json.loads((p/'s169cg-closeout.json').read_bytes())\nroot=Path(prev['satellite_root']);plan=Path(prev['planning_root'])\nif not (p/'s169ch-closeout.json').exists():\n m={k:prev[k] for k in ['planning_root','satellite_root','planning_inherited','satellite_inherited']}\n m.update(planning_previous_commit=prev['planning_commit'],satellite_previous_commit=prev['satellite_commit'],previous_goal_turn='progress',previous_goal_turn_reason='Seed complex inverse certified; uniform five-jet W3-infinity extension rejected by continuum packet')\n (p/'s169ch-closeout.json').write_bytes((json.dumps(m,indent=2)+'\\n').encode())\nsys.path[:0]=[str(p/'s169af-arb'),str(root/'checks')]\nimport sympy as S\nfrom flint import arb,ctx\nimport current_product_matched_source_projection as old\nctx.prec=512\nz,s,t=S.symbols('z s t');be,u,ep,ta,q,c=S.symbols('beta u ep tau q C')\nQ=be+u*z*z+(-4*be-2*u-ta)*z**3+(3*be+u+ep)*z**4-2*ep*z**5+ep*z**6\nR=-S.diff(Q,z,2);lap=lambda x:S.diff(Q*S.diff(x,z),z)\nkm=S.Rational(1,15)-q*q/3\nA=-R*Q/6;B=-Q*S.diff(Q,z)/540;V=R*R/60+lap(R)/30+km/c**2\nF=-2*A*(s*t+s*(s-1)+t*(t-1))/z**2-2*S.diff(A,z)*(s+t)/z-6*B*s*t*(s+t-2)/z**3-6*S.diff(B,z)*s*t/z**2+6*V\nrow=S.Poly(S.expand(z**4*((s+t)*F+z*S.diff(F,z))),z)\nsig=S.Rational(801,200);pars,h,zh,env=old.scalar.prev.york.actual_parameters()\nmapping={be:pars['beta'],u:pars['u'],ep:pars['eps'],ta:pars['tau'],q:pars['q'],c:pars['C']}\ndef val(e):\n if e in mapping:return mapping[e]\n if e.is_Rational:return arb(int(e.p))/int(e.q)\n if e.is_Add:return sum((val(x) for x in e.args),arb(0))\n if e.is_Mul:\n  r=arb(1)\n  for x in e.args:r*=val(x)\n  return r\n if e.is_Pow:return val(e.base)**int(e.exp)\n raise ValueError(e)\nck=[(arb(k)/512).sqrt() for k in [63,7,3,3,7,63]]\ndef prod(i,j):\n total=arb(0)\n for k in range(4):\n  for l in range(k+1):\n   lo=min(i+l,j+k-l);hi=max(i+l,j+k-l)\n   assert lo<=3 and hi<=6,(i,j,k,l)\n   total+=arb(comb(3,k)).sqrt()*comb(k,l)*arb(1801)**2*ck[lo]\n return total\nfq=pars['C']/(arb.pi()*pars['B2']);total=arb(0);records=[]\nfor (power,),coeff in row.terms():\n pol=S.Poly(S.expand(coeff.subs({s:s+sig,t:t+sig})),s,t);v=arb(0)\n for (i,j),coef in pol.terms():v+=val(coef).abs_upper()*prod(i,j)\n pp=arb(power)+arb('4.005');mult=pp**3+12*pp**2+51*pp+100\n contribution=fq*(pp*arb('.01').log()).exp()*mult*v;total+=contribution\n records.append(dict(power=power,coefficient=str(coeff),graph=old.encoded(contribution)))\nout=dict(seed_conversion_third_graph=old.encoded(total),terms=records,claim='Development arithmetic for the cubic local conversion only; continuum conversion identity not certified by this script')\n(p/'s169ch-dev.json').write_bytes((json.dumps(out,indent=2)+'\\n').encode())\nprint(json.dumps({'seed_conversion_third_graph':out['seed_conversion_third_graph'],'powers':[r['power'] for r in records]},indent=2))\n",
